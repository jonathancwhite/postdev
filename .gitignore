node_modules/
# The TypeScript build output is generated, except the committed Action bundle:
# `uses: jonathancwhite/postdev@v1` runs dist/action/index.js straight from the
# repo, so that bundle is tracked. Everything else under dist/ stays ignored.
dist/*
!dist/action
dist/action/**/*.d.ts
dist/action/*.js.map
dist/action/action
dist/action/blastRadius
dist/action/github
dist/action/model
dist/action/review
dist/action/store
# `tsc` also writes src/action/*.ts here; only ncc's bundle and its chunks are tracked.
dist/action/*.js
!dist/action/index.js
!dist/action/*.index.js
*.log
.env
.env.local
.DS_Store
